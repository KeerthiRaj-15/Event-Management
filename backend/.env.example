PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/gather
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000
EVENT_UTC_OFFSET=+05:30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gather <no-reply@example.com>
# mock = no money moves (development) | razorpay = real checkout (test keys = test money)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ADMIN_EMAIL=admin@gather.com
ADMIN_PASSWORD=change-this-before-running-the-seed
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
TICKETMASTER_API_KEY=
# Optional provider filters. Ticketmaster coverage varies by market.
TICKETMASTER_CITY=
TICKETMASTER_COUNTRY_CODE=
